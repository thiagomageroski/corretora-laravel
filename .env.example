APP_NAME=Nivora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HASH_DRIVER=argon2id

# Permanece false ate haver aprovacao juridica e regulatoria.
REAL_MONEY_ENABLED=false

# AmploPay (PIX). Keys stay on the server only.
AMPLOPAY_PUBLIC_KEY=
AMPLOPAY_SECRET_KEY=
# Optional account-wide webhook token
AMPLOPAY_WEBHOOK_TOKEN=
# AmploPay blocks status lookups; payments are confirmed by webhook. Keep false unless your account allows polling.
AMPLOPAY_STATUS_LOOKUPS=false
# Withdrawals up to this amount (cents) skip operator approval; 0 = always review
REAL_AUTO_APPROVE_WITHDRAWAL_MAX_CENTS=0
DEMO_INITIAL_BALANCE_CENTS=1000000
DEMO_DEFAULT_PAYOUT_BPS=8500

# Forex, acoes e ETFs. O plano gratuito nao permite exibicao a terceiros.
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MINUTE=8

REVERB_APP_ID=nivora-local
REVERB_APP_KEY=nivora-local-key
REVERB_APP_SECRET=troque-este-valor
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
